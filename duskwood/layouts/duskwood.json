{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.15"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "duskwood-spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "#0b0e17e6",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "quests",
          "type": "block",
          "size": {
            "px": 46
          },
          "content": {
            "mod": "quest-bar"
          }
        },
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "duskwood-tabs"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "#0a0d16c8",
                  "border": {
                    "width": 1,
                    "color": "#4a3f28"
                  },
                  "focus": {
                    "width": 2,
                    "color": "#d4a93a"
                  },
                  "radius": 4,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            },
            {
              "id": "questlog",
              "type": "block",
              "hidden": true,
              "size": {
                "px": 440
              },
              "min": 340,
              "max": 800,
              "radius": 6,
              "border": {
                "width": 1,
                "color": "#5c4d2e"
              },
              "content": {
                "mod": "quest-log"
              }
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "duskwood-status"
          },
          "size": {
            "px": 30
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": {
    "image": "backgrounds/duskwood.png",
    "fit": "cover"
  },
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "#5c4d2e"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "theme": "duskwood",
  "ui_font": "Copperplate",
  "terminal_opacity": 0.86,
  "preview": "backgrounds/duskwood.png"
}